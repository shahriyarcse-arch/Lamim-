# =============================================================================
# Lamim API — Environment Variables
# =============================================================================
# REQUIRED: Gemini AI API Key for /api/agent
# Without this, the AI assistant falls back to the local offline knowledge engine.
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OPTIONAL: Alternative AI key name (either one is accepted)
# AI_API_KEY=your_alternative_api_key_here

# NOTE: CORS is locked to https://lamim.tech + localhost origins in api/agent.js.
# Add extra origins to the ALLOWED_ORIGINS set in that file if needed (e.g. preview deployments).
