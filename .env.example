# =============================================================================
# Lamim API — Environment Variables
# =============================================================================
# REQUIRED: Gemini AI API Key for /api/agent
# Single key or multiple comma-separated keys for auto-failover/quota rotation:
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEYS=key1,key2,key3

# NOTE: CORS is locked to https://lamim.tech + localhost origins in api/agent.js.
# Add extra origins to the ALLOWED_ORIGINS set in that file if needed (e.g. preview deployments).
