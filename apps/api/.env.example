# Lamim API configuration. Copy the keys into the monorepo root .env (loaded automatically
# in development) or set them as real environment variables. Never commit real values;
# use distinct secrets per environment (dev / staging / prod).

# Neon pooled connection (runtime queries)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# Neon direct (non-pooled) connection (Prisma migrations)
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require

# REQUIRED. HS256 access-token signing key: >= 43 base64url chars of real randomness.
# Left empty on purpose: the API refuses to boot until you generate one, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:3000

# Reverse-proxy hops to trust for the client IP (X-Forwarded-For). REQUIRED when
# NODE_ENV=production: 0 = API is directly exposed, 1 = one proxy / load balancer in front, ...
TRUST_PROXY=0

# Optional
NODE_ENV=development
PORT=3001
DB_SCHEMA=public
LOG_LEVEL=info
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_SYNC_PER_MIN=60
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_EMAIL_PER_15MIN=5
SYNC_MAX_IN_FLIGHT_PER_USER=2
SYNC_QUOTA_ROWS=250000
SYNC_QUOTA_BYTES=104857600
