{
  "name": "@lamim/api",
  "version": "0.0.0",
  "private": true,
  "description": "Lamim cloud API — NestJS modular monolith: auth, LWW sync, health",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "prisma generate && node scripts/build.mjs",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "prisma generate && vitest run --silent",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@lamim/core": "workspace:*",
    "@lamim/sync-protocol": "workspace:*",
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/jwt": "12.0.4",
    "@nestjs/platform-express": "12.4.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "dotenv": "18.0.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@lamim/config": "workspace:*",
    "@lamim/db": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.8",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
